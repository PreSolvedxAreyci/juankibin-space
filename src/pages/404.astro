---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Not found — juankibin">
  <main class="container not-found">
    <img src="/brand/logo.svg" alt="" width="64" height="64" />
    <h1>404</h1>
    <p>That page isn’t here. Head back home.</p>
    <a class="btn btn-primary" href="/">Back to juankibin.space</a>
  </main>
</BaseLayout>

<style>
  .not-found {
    min-height: 80vh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    gap: 0.75rem;
    padding: 3rem 1rem;
  }
  .not-found h1 {
    margin: 0;
    font-size: 4rem;
    background: linear-gradient(120deg, #c084fc, #f59e0b);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .not-found p {
    margin-bottom: 1.25rem;
  }
</style>
